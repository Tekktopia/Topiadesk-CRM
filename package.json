{
  "name": "topiadesk-crm",
  "private": true,
  "version": "0.1.0",
  "description": "TopiaDesk CRM — enterprise CRM/engagement platform",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:generate": "pnpm --filter @topiadesk/db generate",
    "db:migrate:dev": "pnpm --filter @topiadesk/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @topiadesk/db migrate:deploy",
    "db:seed": "pnpm --filter @topiadesk/db seed",
    "generate:api-client": "pnpm --filter @topiadesk/shared-types generate:api-client",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
