{
  "realm": "topiadesk",
  "enabled": true,
  "displayName": "TopiaDesk CRM",
  "loginTheme": "topiadesk",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Full system access" },
      { "name": "MANAGER", "description": "Department head — sees and manages records within their department" },
      { "name": "ACCOUNT_HANDLER", "description": "Front-line broker — manages their own book of business" },
      { "name": "COMPLIANCE_OFFICER", "description": "Audit, approvals, and regulatory oversight" }
    ]
  },

  "clients": [
    {
      "clientId": "topiadesk-web",
      "name": "TopiaDesk Web",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://app.topiadesk.localhost/*##http://localhost:3000/*"
      },
      "redirectUris": [
        "https://app.topiadesk.localhost/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "https://app.topiadesk.localhost",
        "http://localhost:3000"
      ]
    },
    {
      "clientId": "topiadesk-api",
      "name": "TopiaDesk API",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${env.KEYCLOAK_CLIENT_SECRET_API}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "bearerOnly": false
    },
    {
      "clientId": "topiadesk-api-admin",
      "name": "TopiaDesk API Admin (Keycloak Admin REST API service account)",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${env.KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "bearerOnly": false
    }
  ],

  "identityProviders": [
    {
      "alias": "microsoft",
      "displayName": "Microsoft",
      "providerId": "microsoft",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${env.MICROSOFT_IDP_CLIENT_ID}",
        "clientSecret": "${env.MICROSOFT_IDP_CLIENT_SECRET}",
        "tenantId": "${env.MICROSOFT_IDP_TENANT_ID}",
        "syncMode": "IMPORT",
        "defaultScope": "openid profile email User.Read"
      }
    }
  ],

  "users": [
    {
      "username": "service-account-topiadesk-api-admin",
      "enabled": true,
      "serviceAccountClientId": "topiadesk-api-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    },
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "admin",
      "email": "admin@topiadesk.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "TopiaDesk",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "ChangeMe!Admin1", "temporary": true }],
      "requiredActions": ["UPDATE_PASSWORD", "CONFIGURE_TOTP"],
      "realmRoles": ["ADMIN"]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "manager",
      "email": "manager@topiadesk.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Amaka",
      "lastName": "Obi",
      "credentials": [{ "type": "password", "value": "ChangeMe!Manager1", "temporary": true }],
      "requiredActions": ["UPDATE_PASSWORD"],
      "realmRoles": ["MANAGER"]
    },
    {
      "id": "33333333-3333-3333-3333-333333333333",
      "username": "broker",
      "email": "broker@topiadesk.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Tunde",
      "lastName": "Bakare",
      "credentials": [{ "type": "password", "value": "ChangeMe!Broker1", "temporary": true }],
      "requiredActions": ["UPDATE_PASSWORD"],
      "realmRoles": ["ACCOUNT_HANDLER"]
    },
    {
      "id": "44444444-4444-4444-4444-444444444444",
      "username": "compliance",
      "email": "compliance@topiadesk.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Ngozi",
      "lastName": "Eze",
      "credentials": [{ "type": "password", "value": "ChangeMe!Compliance1", "temporary": true }],
      "requiredActions": ["UPDATE_PASSWORD", "CONFIGURE_TOTP"],
      "realmRoles": ["COMPLIANCE_OFFICER"]
    }
  ]
}
