model AiUsageLedger {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  user             User?     @relation("AiUsageUser", fields: [userId], references: [id])
  feature          AiFeature
  tokensIn         Int       @map("tokens_in")
  tokensOut        Int       @map("tokens_out")
  estimatedCostUsd Decimal   @map("estimated_cost_usd") @db.Decimal(10, 4)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("ai_usage_ledger")
}

/// Chunked embeddings for semantic search over notes/documents (first real
/// consumer: backend/api/src/modules/ai-gateway/ POST /ai/index + /ai/search).
/// `embedding` uses pgvector via Prisma's Unsupported type — vector
/// similarity queries are raw SQL (Prisma has no typed query API for it).
/// Dimension is 1024, not the 1536 this column originally shipped with
/// (sized for OpenAI's ada-002/text-embedding-3-small default): Anthropic has
/// no embeddings API, so Voyage AI (Anthropic's recommended embeddings
/// partner — see voyage-client.ts) is the actual provider, and Voyage's
/// `output_dimension` only offers 256/512/1024(default)/2048 — 1536 isn't one
/// of them. Changed via a real migration (20260803_.../migration.sql) rather
/// than editing the original CREATE TABLE, but verified costless first: this
/// table had zero production rows at the time (see that migration's header
/// comment).
model SemanticEmbedding {
  id         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String                      @map("entity_type")
  entityId   String                      @map("entity_id") @db.Uuid
  chunkIndex Int                         @default(0) @map("chunk_index")
  content    String
  embedding  Unsupported("vector(1024)")
  model      String
  createdAt  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([entityType, entityId, model, chunkIndex])
  @@map("semantic_embeddings")
}

