model IntegrationConnector {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String        @unique
  connectorType          ConnectorType @map("connector_type")
  config                 Json
  isEnabled              Boolean       @default(true) @map("is_enabled")
  syncDirection          SyncDirection @map("sync_direction")
  pollingIntervalMinutes Int?          @map("polling_interval_minutes")
  webhookPath            String?       @unique @map("webhook_path")
  lastSuccessfulSyncAt   DateTime?     @map("last_successful_sync_at") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  syncJobs         SyncJob[]
  logs             IntegrationLog[]
  oauthCredentials IntegrationOAuthCredential[]

  @@map("integration_connectors")
}

/// Per-tenant "Sign in with Microsoft 365" self-service config — each
/// tenant admin registers their own Azure App Registration, pushed to
/// their own Keycloak realm's "microsoft" identity provider via
/// KeycloakAdminService (see microsoft-sso.controller.ts). Single logical
/// row per tenant (schema-per-tenant already isolates this, no tenantId
/// column needed — same as every other table here), enforced at the
/// application layer, not a DB constraint. encryptedClientSecret is
/// AES-256-GCM ciphertext via oauth-token-crypto.ts's encrypt()/decrypt()
/// (iv:authTag:ciphertext, hex) — deliberately NOT the plaintext-with-
/// masking pattern IntegrationConnector.config uses, since a client
/// secret needs real encryption at rest, not just response-time redaction.
model MicrosoftSsoConfig {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  azureTenantId         String   @map("azure_tenant_id")
  azureClientId         String   @map("azure_client_id")
  encryptedClientSecret String   @map("encrypted_client_secret")
  isEnabled             Boolean  @default(true) @map("is_enabled")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("microsoft_sso_configs")
}

model SyncJob {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectorId      String               @map("connector_id") @db.Uuid
  connector        IntegrationConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  jobType          String               @map("job_type")
  status           SyncJobStatus        @default(PENDING)
  startedAt        DateTime?            @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?            @map("completed_at") @db.Timestamptz(6)
  recordsProcessed Int                  @default(0) @map("records_processed")
  recordsSucceeded Int                  @default(0) @map("records_succeeded")
  recordsFailed    Int                  @default(0) @map("records_failed")
  triggeredBy      String?              @map("triggered_by")
  correlationId    String               @map("correlation_id")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  logs IntegrationLog[]

  @@map("sync_jobs")
}

model IntegrationLog {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  syncJobId          String?                @map("sync_job_id") @db.Uuid
  syncJob            SyncJob?               @relation(fields: [syncJobId], references: [id], onDelete: SetNull)
  connectorId        String                 @map("connector_id") @db.Uuid
  connector          IntegrationConnector   @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  level              IntegrationLogLevel
  category           IntegrationLogCategory
  externalRecordId   String?                @map("external_record_id")
  internalEntityType String?                @map("internal_entity_type")
  internalEntityId   String?                @map("internal_entity_id") @db.Uuid
  message            String
  payloadSnapshot    Json?                  @map("payload_snapshot")
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("integration_logs")
}

// =============================================================================
// Notifications & automation (foundation tier — see production-hardening
// notes on renewal-alert idempotency)
// =============================================================================

model Notification {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId   String              @map("recipient_user_id") @db.Uuid
  recipient         User                @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  type              String
  title             String
  body              String
  relatedEntityType String?             @map("related_entity_type")
  relatedEntityId   String?             @map("related_entity_id") @db.Uuid
  channel           NotificationChannel
  status            NotificationStatus  @default(PENDING)
  dedupeKey         String              @unique @map("dedupe_key")
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(6)
  readAt            DateTime?           @map("read_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([recipientUserId, status])
  @@map("notifications")
}

model AutomationRule {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  triggerType AutomationTriggerType @map("trigger_type")
  conditions  Json
  actions     Json
  /// Ordered multi-step sequence — additive, optional, and fully
  /// independent of `actions` above. Null/empty means "use the existing
  /// flat `actions` path" (backend/worker/src/automation/
  /// automation-events.queue.ts's processEntityEvent branches on this).
  /// Each element is `{type:'ACTION', actionType, params}` (identical
  /// shape to one `actions` entry), `{type:'APPROVAL_GATE', reason?,
  /// notifyTeamId?, approverUserIds?, requiredApprovals?, onApprove?,
  /// onReject?}`, or `{type:'CONDITION', field, operator, value, onTrue,
  /// onFalse}` — see run-engine.ts for execution. Every element also
  /// carries a stable `id`, used as the addressable target of `goto`
  /// (onApprove/onReject/onTrue/onFalse) — older rows predating branching
  /// simply have no `id`/goto and execute exactly as before (fall through
  /// to the next array index).
  steps       Json?
  isActive    Boolean               @default(true) @map("is_active")
  /// DRAFT rules are never matched by the engine (see the `status:
  /// 'PUBLISHED'` filter in automation-events.queue.ts and
  /// renewal-playbook.ts) regardless of `isActive` — lets the
  /// /admin/workflows builder autosave an in-progress rule without it ever
  /// running. Defaults to PUBLISHED (not DRAFT) so every pre-existing rule,
  /// including ones created via the separate /admin/automations JSON
  /// dialog which never sends this field, keeps running unchanged.
  status      AutomationRuleStatus  @default(PUBLISHED)
  createdById String                @map("created_by_id") @db.Uuid
  createdBy   User                  @relation("AutomationRuleCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  runStates            AutomationRunState[]
  executionLogs        AutomationExecutionLog[]
  defaultForCategories CaseCategory[]

  @@map("automation_rules")
}

enum AutomationRuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AutomationExecutionStatus {
  SUCCESS
  PARTIAL_FAILURE
  FAILED
}

/// One row per firing of an AutomationRule's flat `actions` list — the
/// "simple/flat" trigger path's counterpart to AutomationRunState (which
/// only exists for the `steps`/branching path). Written from both flat
/// execution sites: automation-events.queue.ts's processEntityEvent
/// (ENTITY_EVENT trigger) and renewal-playbook.ts's runRenewalPlaybooks
/// (renewal-threshold trigger) — previously each computed a per-action
/// result list and then discarded it behind a one-line console.log, with
/// zero durable trace of which rule did what, when, distinguishable from a
/// human edit (see this table's own gap-analysis writeup). ruleId is
/// nullable + SetNull (not Cascade) so a log entry survives rule deletion
/// — ruleName is denormalized alongside it for exactly that reason.
model AutomationExecutionLog {
  id            String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId        String?                    @map("rule_id") @db.Uuid
  rule          AutomationRule?            @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ruleName      String                     @map("rule_name")
  /// 'CASE' | 'CLAIM' | 'POLICY' — POLICY covers renewal-playbook firings,
  /// which act on a Policy/RenewalSchedule, not a Case/Claim; kept a plain
  /// string (not CaseManagementEntityType) since it needs to represent that
  /// third case CaseManagementEntityType doesn't model.
  entityType    String                     @map("entity_type")
  entityId      String?                    @map("entity_id") @db.Uuid
  /// 'ENTITY_EVENT' | 'RENEWAL_PLAYBOOK' — which of the two flat-execution
  /// sites produced this row.
  triggerSource String                     @map("trigger_source")
  status        AutomationExecutionStatus
  /// ActionExecutionResult[] — {actionType, ok, error?} per action, in
  /// order (see action-handler.ts).
  actionResults Json                       @map("action_results")
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ruleId, createdAt])
  @@index([entityType, entityId])
  @@map("automation_execution_logs")
}

enum AutomationRunStatus {
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
}

/// One row per in-progress-or-finished execution of an AutomationRule's
/// `steps` sequence against one Case/Claim — the state a WAITING_APPROVAL
/// run needs to resume from once its linked Approval is decided (see
/// run-engine.ts). Only ever created for rules that have `steps` set; the
/// existing flat `actions` path runs synchronously within one queue job
/// and never creates one of these.
model AutomationRunState {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId           String                   @map("rule_id") @db.Uuid
  rule             AutomationRule           @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  entityType       CaseManagementEntityType @map("entity_type")
  entityId         String                   @map("entity_id") @db.Uuid
  status           AutomationRunStatus      @default(RUNNING)
  currentStepIndex Int                      @default(0) @map("current_step_index")
  /// Free-form per-run state bag. Currently one key: `approverAllowlist:
  /// string[]`, written when an APPROVAL_GATE step names specific
  /// `approverUserIds` — frozen at gate-open time so the decision endpoint
  /// can enforce who may decide without re-resolving team membership later
  /// (and so a person leaving a team mid-approval can't change who's
  /// authorized). Absent for gates with no named approvers (today's
  /// unrestricted-decider behavior, unchanged).
  context          Json?
  approvalId       String?                  @map("approval_id") @db.Uuid
  approval         Approval?                @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  /// Set instead of `approvalId` when an APPROVAL_GATE step's
  /// `requiredApprovals > 1` — the multi-approver quorum path, mirroring
  /// PolicyVersion's existing ApprovalChain usage
  /// (policy-version.controller.ts). Mutually exclusive with `approvalId`
  /// per run: a gate is either the single-Approval path or the chain path,
  /// decided once at gate-open time.
  chainId          String?                  @map("approval_chain_id") @db.Uuid
  chain            ApprovalChain?           @relation(fields: [chainId], references: [id], onDelete: SetNull)
  failureReason    String?                  @map("failure_reason")
  startedAt        DateTime                 @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?                @map("completed_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ruleId])
  @@index([entityType, entityId])
  @@index([approvalId])
  @@index([chainId])
  @@map("automation_run_states")
}

