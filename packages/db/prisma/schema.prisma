  OFFLINE
}

enum TeamMemberRole {
  MEMBER
  LEAD
}

enum AccountRelationshipType {
  REFERRAL_SOURCE
  COMPETITOR
  JOINT_VENTURE
  PARENT_SUBSIDIARY
  OTHER
}

enum LeadSource {
