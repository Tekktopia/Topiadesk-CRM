  correlationId    String               @map("correlation_id")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  logs IntegrationLog[]

  @@map("sync_jobs")
}

model IntegrationLog {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  syncJobId          String?                @map("sync_job_id") @db.Uuid
  syncJob            SyncJob?               @relation(fields: [syncJobId], references: [id], onDelete: SetNull)
  connectorId        String                 @map("connector_id") @db.Uuid
  connector          IntegrationConnector   @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  level              IntegrationLogLevel
  category           IntegrationLogCategory
  externalRecordId   String?                @map("external_record_id")
  internalEntityType String?                @map("internal_entity_type")
  internalEntityId   String?                @map("internal_entity_id") @db.Uuid
  message            String
  payloadSnapshot    Json?                  @map("payload_snapshot")
