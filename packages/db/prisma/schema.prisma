enum PermissionScope {
  OWN
  DEPARTMENT
  BRANCH
  ALL
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// Ephemeral agent availability, distinct from UserStatus (account
/// lifecycle) — surfaced in the top header presence selector and by
/// assignment rules that only route to ONLINE agents.
enum PresenceStatus {
  ONLINE
