  riskRating        RiskRating?   @map("risk_rating")
  addressLine1      String?       @map("address_line1")
  addressLine2      String?       @map("address_line2")
  city              String?
  state             String?
  country           String?       @default("NG")
  postalCode        String?       @map("postal_code")
  /// FSC's Account.KYC Status/KYC Expiry/NAICOM ID — compliance fields
  /// gating the "KYC Expiry Flow" automation (see
  /// policy-lifecycle.ts's assertKycValidForRenewal): a RENEWAL policy
  /// version can't be created against this account unless kycStatus is
  /// VERIFIED and kycExpiryDate is more than 30 days out.
  kycStatus         KycStatus     @default(NOT_STARTED) @map("kyc_status")
  kycExpiryDate     DateTime?     @map("kyc_expiry_date") @db.Date
  naicomId          String?       @map("naicom_id")
  parentAccountId   String?       @map("parent_account_id") @db.Uuid
  parentAccount     Account?      @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  subAccounts       Account[]     @relation("AccountHierarchy")
  ownerId           String        @map("owner_id") @db.Uuid
  owner             User          @relation("AccountOwner", fields: [ownerId], references: [id])
  source            String?
  notes             String?
  /// Arbitrary org-defined fields (see CustomFieldDefinition) — a jsonb
  /// column, not an EAV table, so it inherits this row's RLS policy for
  /// free and needs no join on list queries. Validated against active
  /// CustomFieldDefinition rows at the service layer before write.
  customFields      Json          @default("{}") @map("custom_fields")
  /// Composite 0-100 relationship-health signal — renewal status + open
  /// claims + payment aging, NOT underwriting risk (see riskRating, which
  /// stays 100% manual). Recomputed by refresh-health-score.job.ts; null
  /// until the first run, or if the account has no renewal/claims/premium
  /// data to score at all.
  healthScore           Int?      @map("health_score")
  healthScoreComputedAt DateTime? @map("health_score_computed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  contacts         Contact[]
  relationshipsAsA AccountRelationship[] @relation("RelationshipAccountA")
  relationshipsAsB AccountRelationship[] @relation("RelationshipAccountB")
  leads            Lead[]                @relation("LeadConvertedAccount")
  opportunities    Opportunity[]
  policies         Policy[]
  activities       Activity[]
  tasks            Task[]
  cases            Case[]
  surveyResponses  SurveyResponse[]
  loyaltyAccount   LoyaltyAccount?
  slaOverrides     AccountSlaOverride[]
  sites            Site[]

  @@index([status])
  @@map("accounts")
}

model AccountRelationship {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountAId       String                  @map("account_a_id") @db.Uuid
  accountA         Account                 @relation("RelationshipAccountA", fields: [accountAId], references: [id], onDelete: Cascade)
  accountBId       String                  @map("account_b_id") @db.Uuid
  accountB         Account                 @relation("RelationshipAccountB", fields: [accountBId], references: [id], onDelete: Cascade)
  relationshipType AccountRelationshipType @map("relationship_type")
  notes            String?
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([accountAId, accountBId, relationshipType])
  @@map("account_relationships")
}

/// Exactly one of accountId/carrierId must be set — enforced via a raw SQL
/// CHECK constraint (prisma/rls/004_check_constraints.sql); Prisma's DSL
/// cannot express cross-column checks.
model Contact {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId     String?  @map("account_id") @db.Uuid
  account       Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  carrierId     String?  @map("carrier_id") @db.Uuid
  carrier       Carrier? @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  /// Optional — which of the account's Sites (branches) this contact
  /// belongs to, for a corporate client with multiple locations. Not
  /// required: most accounts have zero Sites and every Contact is simply
  /// account-wide.
  siteId        String?  @map("site_id") @db.Uuid
  site          Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  email         String?
  phone         String?
  title         String?
  /// Free text (Spouse/Child/Dependent/Head of Household/...) — only
  /// meaningful when the parent account is AccountType.HOUSEHOLD, but not
  /// enforced as such (same "don't invent cross-field validation the DSL
  /// can't express cleanly" call as elsewhere in this schema). `title`
  /// stays the job-title field for Business-account contacts; this is a
  /// distinct concept even though both are free strings.
  householdRole String?  @map("household_role")
  /// FSC's Contact.ID Type/ID Number — supporting identity-document detail
  /// for the parent Account's kycStatus, not a separate parallel KYC state
  /// on Contact itself (the FSC spec's own field list keeps KYC Status/
  /// Expiry on Account only).
  idType        String?  @map("id_type")
  idNumber      String?  @map("id_number")
  isPrimary     Boolean  @default(false) @map("is_primary")
  /// Set by DataSubjectRequestsController.process() on a DELETE request —
  /// see DataSubjectRequest's own schema comment for why this is anonymize-
  /// in-place, not a hard delete. Non-null is the durable "this contact was
  /// erased" signal, independent of whichever DataSubjectRequest row
  /// triggered it (that row can itself be queried for the full history/who
  /// processed it, but this field is what every other reader — a contact
  /// list, a form pre-fill — needs to check first).
  anonymizedAt  DateTime? @map("anonymized_at") @db.Timestamptz(6)
  customFields  Json     @default("{}") @map("custom_fields")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cases                Case[]
  campaignRecipients   CampaignRecipient[]
  campaignSuppressions CampaignSuppression[]
  createdActivities    Activity[]            @relation("ActivityCreatedByContact")
  portalLoginTokens    PortalLoginToken[]
  portalSessions       PortalSession[]
  policyParticipants   PolicyParticipant[]
  dataSubjectRequests  DataSubjectRequest[]
  consentRecords       ConsentRecord[]

  @@map("contacts")
}

/// General-purpose consent tracking — deliberately NOT a fixed enum for
/// `consentType` (unlike FieldPermission's FIELD_PERMISSION_CATALOG, which
/// has to be fixed because real DTO fields depend on it): a consent type is
/// just a label nothing else in the code branches on, so admins can record
/// "Marketing Email", "Photo/Video Usage", "Third-Party Data Sharing", or
/// anything specific to their business without a migration. Append-only —
/// granting or revoking always INSERTs a new row rather than updating one
/// in place, so "when exactly did this contact consent/withdraw" stays
/// provable after the fact (the same reasoning ClaimStatusHistory/AuditLog
/// already apply elsewhere in this schema). The current status for a
/// (contact, consentType) pair is simply its most recent row by createdAt —
/// computed at read time (see ConsentRecordsController.current()), not
/// tracked as a separate mutable column.
model ConsentRecord {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId    String   @map("contact_id") @db.Uuid
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  consentType  String   @map("consent_type")
  granted      Boolean
  /// How this was captured — "Web form", "Verbal", "Portal", "Email reply",
  /// "Paper form", "Import", etc. Free text, not an enum, same reasoning as
  /// consentType.
  source       String
  notes        String?
  /// Null when self-service (e.g. a future portal opt-in/out) — every
  /// current write path is staff-logged, so always set today, but kept
  /// nullable so a later portal-facing consent flow doesn't need a schema
  /// change.
  recordedById String?  @map("recorded_by_id") @db.Uuid
  recordedBy   User?    @relation("ConsentRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([contactId, consentType, createdAt])
  @@map("consent_records")
}

enum DataSubjectRequestType {
  EXPORT
  DELETE
}

enum DataSubjectRequestStatus {
  PENDING
  COMPLETED
  REJECTED
}

/// NDPR/GDPR-style Data Subject Request — a Contact's "export my data" or
/// "erase my data" request, logged and fulfilled here rather than handled
/// ad hoc. DELETE is fulfilled as in-place anonymization (Contact.
/// anonymizedAt + PII fields overwritten), never a hard row delete —
/// Activity/Case/PolicyParticipant/etc. all FK to contacts, and
/// unconditionally cascading those away would destroy case history and
/// policy participant records that have their own independent retention
/// obligations (insurance records law generally overrides an erasure
/// request for policy-adjacent data anyway — the honest implementation is
/// "stop being personally identifiable", not "vanish from every table").
/// EXPORT's result is captured directly on this row (exportData) rather
/// than routed through the Document/MinIO pipeline — a small point-in-time
/// JSON snapshot, not a file worth its own storage lifecycle.
model DataSubjectRequest {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId     String                    @map("contact_id") @db.Uuid
  contact       Contact                   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  requestType   DataSubjectRequestType    @map("request_type")
  status        DataSubjectRequestStatus  @default(PENDING)
  notes         String?
  requestedById String                    @map("requested_by_id") @db.Uuid
  requestedBy   User                      @relation("DsrRequestedBy", fields: [requestedById], references: [id])
  /// EXPORT only — a point-in-time JSON snapshot (contact fields + related
  /// activities + parent account name), written once by process().
  exportData    Json?                     @map("export_data")
  processedById String?                   @map("processed_by_id") @db.Uuid
  processedBy   User?                     @relation("DsrProcessedBy", fields: [processedById], references: [id])
  processedAt   DateTime?                 @map("processed_at") @db.Timestamptz(6)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("data_subject_requests")
}

/// Passwordless magic-link login for the customer portal (Batch 6) —
/// short-lived (~15 min), single-use. Contacts have no password of their
/// own; this + PortalSession are the entire external-identity auth surface,
/// deliberately separate from Keycloak/internal `User` sessions. Mirrors
/// SurveyResponse.respondToken's proven shape: a per-row secret compared
/// with a constant-time equality check, not a shared/guessable value.
model PortalLoginToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId  String    @map("contact_id") @db.Uuid
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([contactId])
  @@map("portal_login_tokens")
}

/// The portal's own session — a `portal_session` cookie, entirely separate
/// from `td_session` (internal Keycloak-backed sessions). Revocable (unlike
/// a bare stateless JWT) by deleting the row, matching this codebase's
/// existing preference for durable, auditable session state over stateless
/// tricks.
model PortalSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId  String   @map("contact_id") @db.Uuid
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([contactId])
  @@map("portal_sessions")
}

/// A corporate account's separate physical branch/location — e.g. a client
/// with offices in Lagos and Abuja needing distinct on-site contacts.
/// Deliberately NOT linked from Policy (see the Batch plan's scoping note:
/// site-level policy scoping would ripple into policy creation/versioning/
/// premium calc — a real future extension, not built here).
model Site {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  addressLine1 String?  @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String?
  state        String?
  country      String?  @default("NG")
  postalCode   String?  @map("postal_code")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contacts Contact[]

  @@map("sites")
}

model Carrier {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  carrierType     CarrierType         @map("carrier_type")
  amBestRating    String?             @map("am_best_rating")
  linesOfBusiness String[]            @map("lines_of_business")
  panelStatus     CarrierPanelStatus? @map("panel_status")
  treatyType      String?             @map("treaty_type")
  commissionTerms String?             @map("commission_terms")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  contacts          Contact[]
  policies          Policy[]
  marketSubmissions OpportunityMarketSubmission[]

  @@map("carriers")
}

model Pipeline {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  lineOfBusiness String?         @map("line_of_business")
  isActive       Boolean         @default(true) @map("is_active")
  stages         PipelineStage[]
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("pipelines")
}

model PipelineStage {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pipelineId         String        @map("pipeline_id") @db.Uuid
  pipeline           Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name               String
  order              Int
  defaultProbability Int           @map("default_probability")
  isWon              Boolean       @default(false) @map("is_won")
  isLost             Boolean       @default(false) @map("is_lost")
  opportunities      Opportunity[]

  @@unique([pipelineId, order])
  @@map("pipeline_stages")
}

model Lead {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Plain string, not a UUID FK — deliberately targets LeadSource.code
  /// (a stable natural key, @unique below) rather than LeadSource.id, so
  /// `lead.source` keeps meaning exactly what it always has (a short,
  /// human-legible code like "WEB") for every existing reader
  /// (assignment-resolver.util.ts's findMatchingLeadAssignmentRule(),
  /// the Lead->Account conversion, saved-view-filters.ts) without an
  /// `include: { sourceRef: true }` anywhere. onUpdate: Cascade so
  /// renaming a LeadSource's code (admin UI discourages this in practice,
  /// but the DB stays correct either way) propagates automatically instead
  /// of orphaning existing Leads.
  source                 String       @map("source")
  sourceRef              LeadSource   @relation(fields: [source], references: [code], onUpdate: Cascade)
  sourceCampaign         String?      @map("source_campaign")
  firstName              String       @map("first_name")
  lastName               String       @map("last_name")
  email                  String?
  phone                  String?
  companyName            String?      @map("company_name")
  score                  Int          @default(0)
  status                 LeadStatus   @default(NEW)
  assignedToId           String?      @map("assigned_to_id") @db.Uuid
  assignedTo             User?        @relation("LeadAssignee", fields: [assignedToId], references: [id])
  convertedAccountId     String?      @map("converted_account_id") @db.Uuid
  convertedAccount       Account?     @relation("LeadConvertedAccount", fields: [convertedAccountId], references: [id])
  convertedOpportunityId String?      @unique @map("converted_opportunity_id") @db.Uuid
  convertedOpportunity   Opportunity? @relation("LeadConvertedOpportunity", fields: [convertedOpportunityId], references: [id])
  qualificationNotes     String?      @map("qualification_notes")
  customFields           Json         @default("{}") @map("custom_fields")
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  activities Activity[]
  tasks      Task[]

  @@index([status])
  @@map("leads")
}

model Opportunity {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId         String        @map("account_id") @db.Uuid
  account           Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name              String
  pipelineStageId   String        @map("pipeline_stage_id") @db.Uuid
  pipelineStage     PipelineStage @relation(fields: [pipelineStageId], references: [id])
  amount            Decimal       @db.Decimal(15, 2)
  /// ISO 4217 code — Opportunity has no FK path to anything else that
  /// carries currency (unlike Premium/Claim/etc., which inherit Policy.
  /// currency), so it gets its own column, same "NGN default" convention
  /// as Policy.currency. See ExchangeRate for how a non-NGN amount gets
  /// normalized into the org's base currency for dashboard/report totals.
  currency          String        @default("NGN")
  probability       Int
  expectedCloseDate DateTime      @map("expected_close_date") @db.Date
  actualCloseDate   DateTime?     @map("actual_close_date") @db.Date
  wonReason         String?       @map("won_reason")
  lostReason        String?       @map("lost_reason")
  ownerId           String        @map("owner_id") @db.Uuid
  owner             User          @relation("OpportunityOwner", fields: [ownerId], references: [id])
  lineOfBusiness    String?       @map("line_of_business")
  customFields      Json          @default("{}") @map("custom_fields")
  /// Composite 0-100 "is this deal on track" signal — overdue-vs-
  /// expectedCloseDate + activity-engagement-staleness, averaged. Only
  /// computed for OPEN opportunities (pipelineStage.isWon=false AND
  /// isLost=false) — null once a deal is decided, and null until the first
  /// refresh-deal-health.job.ts run. Distinct from `probability` (a
  /// human-set/stage-default forecast weight, never touched by this job).
  dealHealthScore           Int?      @map("deal_health_score")
  dealHealthScoreComputedAt DateTime? @map("deal_health_score_computed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceLead        Lead?                         @relation("LeadConvertedOpportunity")
  marketSubmissions OpportunityMarketSubmission[]
  activities        Activity[]
  tasks             Task[]

  @@map("opportunities")
}

/// An opportunity shopped to multiple carriers simultaneously — brokerage-
/// specific: a plain Opportunity->Carrier FK would lose this.
model OpportunityMarketSubmission {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunityId String                 @map("opportunity_id") @db.Uuid
  opportunity   Opportunity            @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  carrierId     String                 @map("carrier_id") @db.Uuid
  carrier       Carrier                @relation(fields: [carrierId], references: [id])
  quotedPremium Decimal?               @map("quoted_premium") @db.Decimal(15, 2)
  status        MarketSubmissionStatus @default(SUBMITTED)
  submittedAt   DateTime               @default(now()) @map("submitted_at") @db.Timestamptz(6)
  respondedAt   DateTime?              @map("responded_at") @db.Timestamptz(6)
  notes         String?

  @@unique([opportunityId, carrierId])
  @@map("opportunity_market_submissions")
}

/// Consolidates the BRD's "Activity" and "Interaction" concepts. Also the
/// omnichannel-lite conversation log: every channel (call/email/WhatsApp/
/// SMS/portal/social/live chat) writes into this one table against the
/// same parent-entity FKs, so there's no separate channel subsystem to
/// reconcile the way Freshdesk/Zendesk have to engineer (Agent Workspace,
/// omnichannel routing) — see docs/comparison doc.
/// createdById/createdBySystemJob is a one-of pair (like AuditLog's actor
/// columns), enforced by activities_actor_xor in
/// prisma/rls/003_check_constraints.sql — lets a background worker be the
/// "author" of an inbound webhook-ingested message. externalMessageId is
/// nullable-unique so a provider's webhook retry is a no-op at the DB
/// layer, not a duplicate row.
model Activity {
  id                  String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId           String?                      @map("account_id") @db.Uuid
  account             Account?                     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId           String?                      @map("contact_id") @db.Uuid
  leadId              String?                      @map("lead_id") @db.Uuid
  lead                Lead?                        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId       String?                      @map("opportunity_id") @db.Uuid
  opportunity         Opportunity?                 @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  policyId            String?                      @map("policy_id") @db.Uuid
  policy              Policy?                      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  claimId             String?                      @map("claim_id") @db.Uuid
  claim               Claim?                       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  caseId              String?                      @map("case_id") @db.Uuid
  case                Case?                        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type                ActivityType
  direction           ActivityDirection
  subject             String
  body                String?
  occurredAt          DateTime                     @map("occurred_at") @db.Timestamptz(6)
  createdById         String?                      @map("created_by_id") @db.Uuid
  createdBy           User?                        @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  createdBySystemJob  String?                      @map("created_by_system_job")
  /// Set instead of createdById when a portal Contact (not internal staff)
  /// authored this — a customer-portal case reply. Distinct from the
  /// existing `contactId` above, which records which contact an activity
  /// is ABOUT (e.g. a logged call), not who wrote it.
  createdByContactId  String?                      @map("created_by_contact_id") @db.Uuid
  createdByContact    Contact?                     @relation("ActivityCreatedByContact", fields: [createdByContactId], references: [id])
  channelDetail       String?                      @map("channel_detail")
  externalThreadId    String?                      @map("external_thread_id")
  externalMessageId   String?                      @unique @map("external_message_id")
  emailDeliveryStatus ActivityEmailDeliveryStatus? @map("email_delivery_status")
  aiSentiment         String?                      @map("ai_sentiment")
  aiSentimentScore    Decimal?                     @map("ai_sentiment_score") @db.Decimal(4, 3)
  aiAnalyzedAt        DateTime?                    @map("ai_analyzed_at") @db.Timestamptz(6)
  durationMinutes     Int?                         @map("duration_minutes")
  outcome             String?
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountId, occurredAt])
  @@index([externalThreadId])
  @@index([claimId])
  @@index([caseId])
  @@map("activities")
}

model Task {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  description   String?
  dueDate       DateTime?    @map("due_date") @db.Timestamptz(6)
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(OPEN)
  assigneeId    String       @map("assignee_id") @db.Uuid
  assignee      User         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  accountId     String?      @map("account_id") @db.Uuid
  account       Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  policyId      String?      @map("policy_id") @db.Uuid
  policy        Policy?      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  opportunityId String?      @map("opportunity_id") @db.Uuid
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  leadId        String?      @map("lead_id") @db.Uuid
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  claimId       String?      @map("claim_id") @db.Uuid
  claim         Claim?       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  caseId        String?      @map("case_id") @db.Uuid
  case          Case?        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([assigneeId, status])
  @@map("tasks")
}

// =============================================================================
// Policy lifecycle
// =============================================================================

model Policy {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyNumber         String         @unique @map("policy_number")
  accountId            String         @map("account_id") @db.Uuid
  account              Account        @relation(fields: [accountId], references: [id])
  carrierId            String         @map("carrier_id") @db.Uuid
  carrier              Carrier        @relation(fields: [carrierId], references: [id])
  lineOfBusiness       String         @map("line_of_business")
  sumInsured           Decimal?       @map("sum_insured") @db.Decimal(18, 2)
  currency             String         @default("NGN")
  inceptionDate        DateTime       @map("inception_date") @db.Date
  expiryDate           DateTime       @map("expiry_date") @db.Date
  status               PolicyStatus   @default(QUOTED)
  brokerOfRecordId     String?        @map("broker_of_record_id") @db.Uuid
  brokerOfRecord       User?          @relation("PolicyBrokerOfRecord", fields: [brokerOfRecordId], references: [id])
  currentVersionId     String?        @unique @map("current_version_id") @db.Uuid
  currentVersion       PolicyVersion? @relation("PolicyCurrentVersion", fields: [currentVersionId], references: [id])
  externalSourceSystem String?        @map("external_source_system")
  externalSourceId     String?        @map("external_source_id")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions            PolicyVersion[]            @relation("PolicyVersions")
  premiums            Premium[]
  renewalSchedule     RenewalSchedule?
  activities          Activity[]
  tasks               Task[]
  claims              Claim[]
  cases               Case[]
  loyaltyTransactions LoyaltyTransaction[]
  producerAssignments ProducerPolicyAssignment[]
  producerCommissions ProducerCommission[]
  coverages           PolicyCoverage[]
  participants        PolicyParticipant[]
  assets              PolicyAsset[]
  signatureRequests   SignatureRequest[]

  @@index([expiryDate])
  @@map("policies")
}

model PolicyVersion {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId            String            @map("policy_id") @db.Uuid
  policy              Policy            @relation("PolicyVersions", fields: [policyId], references: [id], onDelete: Cascade)
  versionNumber       Int               @map("version_number")
  versionType         PolicyVersionType @map("version_type")
  effectiveDate       DateTime          @map("effective_date") @db.Date
  changeDescription   String?           @map("change_description")
  premiumImpact       Decimal?          @map("premium_impact") @db.Decimal(15, 2)
  sumInsuredAtVersion Decimal?          @map("sum_insured_at_version") @db.Decimal(18, 2)
  documentId          String?           @map("document_id") @db.Uuid
  document            Document?         @relation(fields: [documentId], references: [id])
  createdById         String            @map("created_by_id") @db.Uuid
  createdBy           User              @relation("PolicyVersionCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  premiums         Premium[]
  currentForPolicy Policy?   @relation("PolicyCurrentVersion")

  @@unique([policyId, versionNumber])
  @@map("policy_versions")
}

/// Aging is computed via a nightly-refreshed materialized view
/// (premium_aging_summary — see prisma/rls/005_reporting_views.sql), not a
/// read-time generated column: Postgres generated columns can't reference
/// CURRENT_DATE (not immutable).
model Premium {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId         String         @map("policy_id") @db.Uuid
  policy           Policy         @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyVersionId  String?        @map("policy_version_id") @db.Uuid
  policyVersion    PolicyVersion? @relation(fields: [policyVersionId], references: [id])
  grossPremium     Decimal        @map("gross_premium") @db.Decimal(15, 2)
  netPremium       Decimal        @map("net_premium") @db.Decimal(15, 2)
  commissionRate   Decimal?       @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Decimal?       @map("commission_amount") @db.Decimal(15, 2)
  installmentPlan  String?        @map("installment_plan")
  dueDate          DateTime       @map("due_date") @db.Date
  paidAmount       Decimal        @default(0) @map("paid_amount") @db.Decimal(15, 2)
  paidDate         DateTime?      @map("paid_date") @db.Date
  status           PremiumStatus  @default(PENDING)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  producerCommissions ProducerCommission[]

  @@index([status, dueDate])
  @@map("premiums")
}

/// nextAlertDueAt is the scan column the worker's renewal job polls every
/// ~15 minutes — kept Postgres-durable rather than pre-scheduled far out in
/// Redis so a Redis restart can never silently drop a renewal reminder.
model RenewalSchedule {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId           String        @unique @map("policy_id") @db.Uuid
  policy             Policy        @relation(fields: [policyId], references: [id], onDelete: Cascade)
  renewalDueDate     DateTime      @map("renewal_due_date") @db.Date
  alertThresholds    Int[]         @default([90, 60, 30, 7]) @map("alert_thresholds")
  status             RenewalStatus @default(ON_TRACK)
  assignedToId       String?       @map("assigned_to_id") @db.Uuid
  assignedTo         User?         @relation("RenewalAssignee", fields: [assignedToId], references: [id])
  lastAlertSentAt    DateTime?     @map("last_alert_sent_at") @db.Timestamptz(6)
  nextAlertDueAt     DateTime      @map("next_alert_due_at") @db.Timestamptz(6)
  renewalMeetingDate DateTime?     @map("renewal_meeting_date") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([nextAlertDueAt])
  @@map("renewal_schedules")
}

// =============================================================================
// Policy depth — Coverages / Participants / Assets
//
// FSC's InsurancePolicyCoverage/InsurancePolicyParticipant/
// InsurancePolicyAsset, all child-of-Policy. No dedicated RLS/permission
// resource — all three reuse the 'policy' resource (see 002_policies.sql),
// same reasoning as ProducerPolicyAssignment in the Producers block below:
// nothing in the FSC spec calls for independently-tunable visibility here,
// unlike ProducerCommission's $ amounts.
// =============================================================================

/// Coverage type is a free string (not an enum) — deliberately mirrors
/// Policy.lineOfBusiness itself: what counts as a coverage type varies by
/// line of business (Motor's "Comprehensive"/"Third Party" vs Marine's
/// "All Risks"/"Total Loss Only" etc.), and this codebase already treats
/// line-of-business classification as broker-entered text, not a fixed
/// taxonomy.
model PolicyCoverage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId     String   @map("policy_id") @db.Uuid
  policy       Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  coverageName String   @map("coverage_name")
  coverageType String   @map("coverage_type")
  sumInsured   Decimal? @map("sum_insured") @db.Decimal(18, 2)
  premium      Decimal? @map("premium") @db.Decimal(15, 2)
  deductible   Decimal? @map("deductible") @db.Decimal(15, 2)
  limits       String?
  subLimits    String?  @map("sub_limits")
  conditions   String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([policyId])
  @@map("policy_coverages")
}

enum ParticipantType {
  INSURED
  BENEFICIARY
  NOMINEE
  DRIVER
  ADDITIONAL_INSURED
}

/// `name` is always captured directly (not derived from `contact` at read
/// time) — beneficiary/nominee designations are conventionally frozen as of
/// when they're set, the same way a signed form wouldn't retroactively
/// change if the named person's CRM contact record is edited later.
/// `contactId` is optional and purely a convenience link for participants
/// who happen to already be a TopiaDesk Contact — most Nominees/
/// Beneficiaries never are.
model PolicyParticipant {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId        String          @map("policy_id") @db.Uuid
  policy          Policy          @relation(fields: [policyId], references: [id], onDelete: Cascade)
  participantType ParticipantType @map("participant_type")
  name            String
  contactId       String?         @map("contact_id") @db.Uuid
  contact         Contact?        @relation(fields: [contactId], references: [id])
  relationship    String?
  percentage      Decimal?        @db.Decimal(5, 2)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([policyId])
  @@index([contactId])
  @@map("policy_participants")
}

enum AssetType {
  VEHICLE
  PROPERTY
  CARGO
  VESSEL
}

/// Location captured as plain lat/lng decimals — no PostGIS dependency for
/// what's currently just a display pin, same "don't reach for
/// infrastructure the actual requirement doesn't need yet" call as
/// elsewhere in this schema.
model PolicyAsset {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId       String    @map("policy_id") @db.Uuid
  policy         Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  assetType      AssetType @map("asset_type")
  assetName      String    @map("asset_name")
  registrationNo String?   @map("registration_no")
  chassisNo      String?   @map("chassis_no")
  address        String?
  valuation      Decimal?  @db.Decimal(18, 2)
  year           Int?
  makeModel      String?   @map("make_model")
  latitude       Decimal?  @db.Decimal(9, 6)
  longitude      Decimal?  @db.Decimal(9, 6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([policyId])
  @@map("policy_assets")
}

// =============================================================================
// Producers / Commissions
//
// A commission-earning party on a policy — distinct from `Policy.
// brokerOfRecordId` (a single-User FK for who owns the client relationship)
// because a Producer need not be a TopiaDesk User at all (external
// sub-brokers/correspondents from other firms are tracked here with no
// system login), and a policy can split commission across several of them.
// =============================================================================

enum ProducerType {
  INTERNAL_BROKER
  EXTERNAL_SUB_BROKER
  CORRESPONDENT
}

enum ProducerStatus {
  ACTIVE
  SUSPENDED
}

model Producer {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  producerCode     String         @unique @map("producer_code")
  name             String
  type             ProducerType   @default(INTERNAL_BROKER)
  status           ProducerStatus @default(ACTIVE)
  licenseNumber    String?        @map("license_number")
  licenseExpiry    DateTime?      @map("license_expiry") @db.Date
  phone            String?
  email            String?
  parentProducerId String?        @map("parent_producer_id") @db.Uuid
  parentProducer   Producer?      @relation("ProducerHierarchy", fields: [parentProducerId], references: [id])
  subProducers     Producer[]     @relation("ProducerHierarchy")
  linkedUserId     String?        @unique @map("linked_user_id") @db.Uuid
  linkedUser       User?          @relation(fields: [linkedUserId], references: [id])
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  policyAssignments ProducerPolicyAssignment[]
  commissions       ProducerCommission[]

  @@index([parentProducerId])
  @@map("producers")
}

enum ProducerAssignmentRole {
  PRIMARY
  SUB_PRODUCER
  SERVICING
}

/// Per-policy commission split — a policy can have multiple producers (e.g.
/// a primary broker plus a servicing sub-producer), each with their own %.
model ProducerPolicyAssignment {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId               String                 @map("policy_id") @db.Uuid
  policy                 Policy                 @relation(fields: [policyId], references: [id], onDelete: Cascade)
  producerId             String                 @map("producer_id") @db.Uuid
  producer               Producer               @relation(fields: [producerId], references: [id])
  role                   ProducerAssignmentRole @default(PRIMARY)
  commissionSplitPercent Decimal                @map("commission_split_percent") @db.Decimal(5, 2)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([policyId, producerId])
  @@index([producerId])
  @@map("producer_policy_assignments")
}

enum ProducerCommissionStatus {
  PENDING
  APPROVED
  PAID
}

/// The actual payable record — one per producer per premium installment
/// (optionally linked to the specific Premium row it was computed from).
/// VAT/WHT are captured as explicit amounts entered by whoever approves the
/// commission, not an auto-applied global rate — real tax rates are a
/// finance/config decision out of scope for this pass.
model ProducerCommission {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commissionNumber  String                   @unique @map("commission_number")
  policyId          String                   @map("policy_id") @db.Uuid
  policy            Policy                   @relation(fields: [policyId], references: [id])
  producerId        String                   @map("producer_id") @db.Uuid
  producer          Producer                 @relation(fields: [producerId], references: [id])
  premiumId         String?                  @map("premium_id") @db.Uuid
  premium           Premium?                 @relation(fields: [premiumId], references: [id])
  premiumBase       Decimal                  @map("premium_base") @db.Decimal(15, 2)
  commissionPercent Decimal                  @map("commission_percent") @db.Decimal(5, 2)
  commissionAmount  Decimal                  @map("commission_amount") @db.Decimal(15, 2)
  vatAmount         Decimal                  @default(0) @map("vat_amount") @db.Decimal(15, 2)
  whtAmount         Decimal                  @default(0) @map("wht_amount") @db.Decimal(15, 2)
  netPayable        Decimal                  @map("net_payable") @db.Decimal(15, 2)
  status            ProducerCommissionStatus @default(PENDING)
  /// Commission period/month, e.g. "2026-08" — not a DateTime since it's a
  /// label for a payroll-style period, not a specific instant.
  period            String
  paymentDate       DateTime?                @map("payment_date") @db.Date
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([producerId, status])
  @@index([policyId])
  @@map("producer_commissions")
}

// =============================================================================
// Documents
// =============================================================================

model Document {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileName          String            @map("file_name")
  mimeType          String            @map("mime_type")
  sizeBytes         BigInt            @map("size_bytes")
  categoryId        String?           @map("category_id") @db.Uuid
  category          DocumentCategory? @relation(fields: [categoryId], references: [id])
  currentVersionId  String?           @unique @map("current_version_id") @db.Uuid
  currentVersion    DocumentVersion?  @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id])
  uploadedById      String            @map("uploaded_by_id") @db.Uuid
  uploadedBy        User              @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  retentionPolicyId String?           @map("retention_policy_id") @db.Uuid
  retentionPolicy   RetentionPolicy?  @relation(fields: [retentionPolicyId], references: [id])
  isArchived        Boolean           @default(false) @map("is_archived")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions          DocumentVersion[]    @relation("DocumentVersions")
  links             DocumentLink[]
  policyVersions    PolicyVersion[]
  signatureRequests SignatureRequest[]

  @@map("documents")
}

model DocumentVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  document       Document @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber  Int      @map("version_number")
  storageKey     String   @map("storage_key")
  storageBucket  String   @map("storage_bucket")
  sizeBytes      BigInt   @map("size_bytes")
  checksumSha256 String   @map("checksum_sha256")
  uploadedById   String   @map("uploaded_by_id") @db.Uuid
  uploadedBy     User     @relation("DocumentVersionUploadedBy", fields: [uploadedById], references: [id])
  changeNote     String?  @map("change_note")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  currentForDocument Document? @relation("DocumentCurrentVersion")
  signatureRequests  SignatureRequest[]

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

enum SignatureRequestStatus {
  SENT
  VIEWED
  SIGNED
  DECLINED
  EXPIRED
}

/// E-signature request for a policy document — sent out to an external
/// signer (never a TopiaDesk `User`), tracked through SENT->VIEWED->SIGNED/
/// DECLINED/EXPIRED. Deliberately NOT built on the existing Approval system
/// (ApprovalEntityType/Approval/ApprovalChain) — those model INTERNAL
/// sign-off by a TopiaDesk User with a PENDING/APPROVED/REJECTED shape that
/// has no signer-email/viewed/expired concept and no external party. Pinned
/// to `documentVersionId` (not just `documentId`) so a later re-upload that
/// bumps Document.currentVersionId can never retroactively change which
/// exact bytes a signer is shown to have signed. `policyId` required (not
/// nullable) — this feature is scoped to policy documents specifically, per
/// its own gap-analysis item; RLS therefore inherits policy_versions_rw's
/// exact child-of-policy-of-account shape. See esignature.service.ts for
/// the (stubbed — no live DocuSign credentials in this environment)
/// send/webhook logic, same "real model, stubbed external call" pattern as
/// paystack.service.ts.
model SignatureRequest {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId         String                 @map("document_id") @db.Uuid
  document           Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersionId  String                 @map("document_version_id") @db.Uuid
  documentVersion    DocumentVersion        @relation(fields: [documentVersionId], references: [id])
  policyId           String                 @map("policy_id") @db.Uuid
  policy             Policy                 @relation(fields: [policyId], references: [id], onDelete: Cascade)
  signerName         String                 @map("signer_name")
  signerEmail        String                 @map("signer_email")
  status             SignatureRequestStatus @default(SENT)
  /// Fabricated (`stub_<uuid>`) in this environment — see
  /// esignature.service.ts. A real integration would store DocuSign's own
  /// envelopeId here.
  externalEnvelopeId String                 @map("external_envelope_id")
  sentById           String                 @map("sent_by_id") @db.Uuid
  sentBy             User                   @relation("SignatureRequestSentBy", fields: [sentById], references: [id])
  sentAt             DateTime               @default(now()) @map("sent_at") @db.Timestamptz(6)
  viewedAt           DateTime?              @map("viewed_at") @db.Timestamptz(6)
  signedAt           DateTime?              @map("signed_at") @db.Timestamptz(6)
  declinedAt         DateTime?              @map("declined_at") @db.Timestamptz(6)
  declineReason      String?                @map("decline_reason")
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([documentId])
  @@index([policyId])
  @@map("signature_requests")
}

/// The one legitimately polymorphic table — entityType/entityId, integrity
/// enforced at the service layer against a small fixed entityType->repository
/// map (not a DB FK, since Postgres can't FK across multiple target tables).
model DocumentLink {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String             @map("document_id") @db.Uuid
  document   Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entityType DocumentEntityType @map("entity_type")
  entityId   String             @map("entity_id") @db.Uuid
  linkedById String             @map("linked_by_id") @db.Uuid
  linkedBy   User               @relation("DocumentLinkedBy", fields: [linkedById], references: [id])
  linkedAt   DateTime           @default(now()) @map("linked_at") @db.Timestamptz(6)

  @@unique([documentId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("document_links")
}

model DocumentCategory {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique
  code String @unique

  documents Document[]

  @@map("document_categories")
}

model RetentionPolicy {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String?         @map("category_id") @db.Uuid
  retentionYears Int             @map("retention_years")
  actionOnExpiry RetentionAction @map("action_on_expiry")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  documents Document[]

  @@map("retention_policies")
}

// =============================================================================
// Audit (hash-chained, insert-only — see prisma/triggers/)
// =============================================================================

model AuditLog {
  id             BigInt      @id @default(autoincrement())
  entityType     String      @map("entity_type")
  entityId       String      @map("entity_id") @db.Uuid
  action         AuditAction
  actorUserId    String?     @map("actor_user_id") @db.Uuid
  actorUser      User?       @relation("AuditActorUser", fields: [actorUserId], references: [id])
  actorSystemJob String?     @map("actor_system_job")
  actorIp        String?     @map("actor_ip")
  changedFields  Json?       @map("changed_fields")
  chainLane      Int         @map("chain_lane")
  prevHash       String?     @map("prev_hash") @db.Char(64)
  currentHash    String      @map("current_hash") @db.Char(64)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([chainLane, id])
  @@map("audit_log")
}

model AuditCheckpoint {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkpointAt DateTime @map("checkpoint_at") @db.Timestamptz(6)
  laneHashes   Json     @map("lane_hashes")
  anchorHash   String   @map("anchor_hash") @db.Char(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("audit_checkpoints")
}

// =============================================================================
// Governance (maker-checker — satisfies the Phase-1 segregation-of-duties NFR
// without a full workflow/BPM engine)
// =============================================================================

model Approval {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType    ApprovalEntityType @map("entity_type")
  entityId      String             @map("entity_id") @db.Uuid
  requestedById String             @map("requested_by_id") @db.Uuid
  requestedBy   User               @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?            @map("approved_by_id") @db.Uuid
  approvedBy    User?              @relation("ApprovalApprovedBy", fields: [approvedById], references: [id])
  status        ApprovalStatus     @default(PENDING)
  reason        String?
  /// The DECIDER's own comment, set at decision time — distinct from
  /// `reason` above, which is the REQUESTER's static explanation set once
  /// at gate-open time (e.g. an AutomationRule author's configured gate
  /// description). Different people, different moments; must not share a
  /// column. Surfaced on AutomationRunState's decision endpoint as `note`.
  decisionNote  String?            @map("decision_note")
  decidedAt     DateTime?          @map("decided_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Nullable, additive: when null (every pre-existing domain — CASE_CLOSURE,
  /// KNOWLEDGE_ARTICLE_PUBLISH, CASE_AUTOMATION_GATE, and the common case of
  /// POLICY_ENDORSEMENT/CANCELLATION below any configured threshold),
  /// behavior is byte-for-byte identical to before this field existed — one
  /// Approval row IS the whole decision. When set, multiple Approval rows
  /// (one per approver's decision) share a chain; the chain — not any single
  /// row — is the source of truth for whether the gated action applies. See
  /// policy-version.controller.ts's decideApproval().
  chainId       String?            @map("chain_id") @db.Uuid
  chain         ApprovalChain?     @relation(fields: [chainId], references: [id], onDelete: Cascade)

  automationRunStates AutomationRunState[]

  @@index([entityType, entityId])
  @@map("approvals")
}

/// Multi-level approval — currently only created for POLICY_ENDORSEMENT/
/// CANCELLATION versions whose premiumImpact/sumInsuredAtVersion crosses an
/// ApprovalThresholdRule. requiredApprovals distinct APPROVED decisions
/// (see the Approval rows linked via chainId) satisfy the chain; any single
/// REJECTED decision rejects it immediately. Deliberately NOT wired into
/// CASE_CLOSURE/KNOWLEDGE_ARTICLE_PUBLISH/CASE_AUTOMATION_GATE — none of
/// those domains has a real dollar amount to threshold against, and forcing
/// one would be unmotivated complexity for zero benefit.
model ApprovalChain {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType        ApprovalEntityType @map("entity_type")
  entityId          String             @map("entity_id") @db.Uuid
  requiredApprovals Int                @map("required_approvals")
  status            ApprovalStatus     @default(PENDING)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  approvals           Approval[]
  automationRunStates AutomationRunState[]

  @@index([entityType, entityId])
  @@map("approval_chains")
}

/// Admin-configurable "if this PolicyVersion's premiumImpact/sumInsured
/// exceeds $X, require N approvals instead of 1" — resolved the same
/// most-specific-wins way resolveSlaPolicy() picks an SlaPolicy: the
/// smallest configured minAmount that the actual amount still clears wins;
/// a rule with minAmount null is the catch-all default. Zero rules
/// configured for a versionType means requiredApprovals is always 1 —
/// today's pre-existing single-approver behavior, unchanged.
model ApprovalThresholdRule {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionType       PolicyVersionType @map("version_type")
  minAmount         Decimal?          @map("min_amount") @db.Decimal(18, 2)
  requiredApprovals Int               @default(1) @map("required_approvals")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("approval_threshold_rules")
}

/// Self-service "while I'm out, my pending decisions go to X too" — a
/// time-boxed standing instruction, not a one-off reassignment of any
/// specific Approval row. Only load-bearing for CASE_AUTOMATION_GATE
/// approvals with a frozen `AutomationRunState.context.approverAllowlist`
/// (see that field's own comment): `approvals_rw`/`automation_run_states_rw`
/// (prisma/rls/002_policies.sql) both OR in "an active delegate of someone
/// on the allowlist" alongside the allowlist itself, and
/// AutomationRunStatesController.decide()'s own allowlist check does the
/// same in application code. For the other four Approval entityTypes,
/// deciding is already a broad `approval:write` ALL-scope pool
/// (COMPLIANCE_OFFICER/ADMIN today) with no per-individual gate to delegate
/// — a delegation row there has nothing to widen, so nothing reads it.
model ApprovalDelegation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  delegatorId String   @map("delegator_id") @db.Uuid
  delegator   User     @relation("ApprovalDelegationDelegator", fields: [delegatorId], references: [id])
  delegateId  String   @map("delegate_id") @db.Uuid
  delegate    User     @relation("ApprovalDelegationDelegate", fields: [delegateId], references: [id])
  startsAt    DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime @map("ends_at") @db.Timestamptz(6)
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([delegatorId])
  @@index([delegateId])
  @@map("approval_delegations")
}

