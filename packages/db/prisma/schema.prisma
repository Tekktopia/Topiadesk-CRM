  description String?
  members     TeamMember[]
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  assignedClaims         Claim[]
  assignedCases          Case[]
  assignmentRulePools    AssignmentRule[]
  savedViews             SavedView[]
  slaEscalationTargetFor SlaTarget[]

  @@map("teams")
}

/// Additive visibility grant on top of department/branch RLS scoping —
/// not a third nested RLS level. See prisma/rls/003_policies.sql.
model TeamMember {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String         @map("team_id") @db.Uuid
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String         @map("user_id") @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TeamMemberRole @default(MEMBER)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([teamId, userId])
  @@map("team_members")
}

model User {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keycloakSubjectId String         @unique @map("keycloak_subject_id")
  email             String         @unique
  fullName          String         @map("full_name")
  phone             String?
  /// MinIO object key under the shared documents bucket (`avatars/{userId}/...`)
  /// — never a public URL, since MinIO isn't internet-reachable (same
  /// reasoning as DocumentVersion.storageKey). Streamed through
  /// GET /identity/me/avatar, self-only in this pass.
  avatarStorageKey  String?        @map("avatar_storage_key")
  departmentId      String?        @map("department_id") @db.Uuid
  department        Department?    @relation(fields: [departmentId], references: [id])
  branchId          String?        @map("branch_id") @db.Uuid
  branch            Branch?        @relation(fields: [branchId], references: [id])
  /// Free text (e.g. "Team Lead", "Supervisor", "Senior Agent") — display/
  /// labeling only, deliberately not a closed enum. The functional
  /// reporting-line piece workflows actually route approvals through is
  /// managerId below, not this field.
  positionTitle     String?        @map("position_title")
  managerId         String?        @map("manager_id") @db.Uuid
  manager           User?          @relation("UserManager", fields: [managerId], references: [id])
  directReports     User[]         @relation("UserManager")
  status            UserStatus     @default(ACTIVE)
  presenceStatus    PresenceStatus @default(OFFLINE) @map("presence_status")
  presenceUpdatedAt DateTime?      @map("presence_updated_at") @db.Timestamptz(6)
  lastSyncedAt      DateTime?      @map("last_synced_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles           UserRole[]
  teamMemberships TeamMember[]

  ownedAccounts               Account[]            @relation("AccountOwner")
  ownedOpportunities          Opportunity[]        @relation("OpportunityOwner")
  assignedLeads               Lead[]               @relation("LeadAssignee")
  assignedTasks               Task[]               @relation("TaskAssignee")
  createdActivities           Activity[]           @relation("ActivityCreatedBy")
  brokeredPolicies            Policy[]             @relation("PolicyBrokerOfRecord")
  createdPolicyVersions       PolicyVersion[]      @relation("PolicyVersionCreatedBy")
  assignedRenewals            RenewalSchedule[]    @relation("RenewalAssignee")
  uploadedDocuments           Document[]           @relation("DocumentUploadedBy")
  uploadedDocumentVersions    DocumentVersion[]    @relation("DocumentVersionUploadedBy")
  linkedDocuments             DocumentLink[]       @relation("DocumentLinkedBy")
  auditEntries                AuditLog[]           @relation("AuditActorUser")
  requestedApprovals          Approval[]           @relation("ApprovalRequestedBy")
  decidedApprovals            Approval[]           @relation("ApprovalApprovedBy")
  approvalDelegationsGiven    ApprovalDelegation[] @relation("ApprovalDelegationDelegator")
  approvalDelegationsReceived ApprovalDelegation[] @relation("ApprovalDelegationDelegate")
  notifications               Notification[]       @relation("NotificationRecipient")
  createdAutomationRules      AutomationRule[]     @relation("AutomationRuleCreatedBy")
  aiUsage                     AiUsageLedger[]      @relation("AiUsageUser")
  ownedDashboards             SavedDashboard[]     @relation("DashboardOwner")
  updatedOrgSettings          OrgSetting[]         @relation("OrgSettingUpdatedBy")
  dsrRequested                DataSubjectRequest[] @relation("DsrRequestedBy")
  dsrProcessed                DataSubjectRequest[] @relation("DsrProcessedBy")
  consentRecordsLogged        ConsentRecord[]      @relation("ConsentRecordedBy")
  signatureRequestsSent       SignatureRequest[]   @relation("SignatureRequestSentBy")
  exchangeRatesUpdated        ExchangeRate[]       @relation("ExchangeRateUpdatedBy")

  // --- Phase 2: Case management ---
  adjustedClaims          Claim[]              @relation("ClaimAdjuster")
  assignedCases           Case[]               @relation("CaseAssignee")
  createdCases            Case[]               @relation("CaseCreatedBy")
  slaEscalationTargetFor  SlaTarget[]          @relation("SlaEscalationUser")
  claimStatusChanges      ClaimStatusHistory[] @relation("ClaimStatusHistoryChangedBy")
  caseWatching            CaseWatcher[]        @relation("CaseWatcherUser")
  createdMacros           Macro[]              @relation("MacroCreatedBy")
  assignmentRuleCursorFor AssignmentRule[]     @relation("AssignmentRuleCursor")
  agentSkills             AgentSkill[]         @relation("AgentSkillUser")

  // --- Phase 2: Knowledge base & surveys ---
  ownedKnowledgeArticles           KnowledgeArticle[]         @relation("KnowledgeArticleOwner")
  authoredKnowledgeArticleVersions KnowledgeArticleVersion[]  @relation("KnowledgeArticleVersionAuthoredBy")
  knowledgeArticleFeedback         KnowledgeArticleFeedback[] @relation("KnowledgeArticleFeedbackUser")
  createdSurveys                   Survey[]                   @relation("SurveyCreatedBy")
  ratedSurveyResponses             SurveyResponse[]           @relation("SurveyResponseAgent")
  loyaltyTransactionsCreated       LoyaltyTransaction[]       @relation("LoyaltyTransactionCreatedBy")

  // --- Phase 2: CRM enhancements ---
  ownedSavedViews SavedView[]  @relation("SavedViewOwner")
  salesQuotas     SalesQuota[] @relation("SalesQuotaUser")

  // --- Producer/Commission model ---
  /// Set only for an internal broker who's also a TopiaDesk User — external
  /// sub-brokers/correspondents have a Producer row with this left unset.
  producerProfile Producer?

  // --- Phase 2: Reporting & campaigns ---
  ownedScheduledReports        ScheduledReport[]          @relation("ScheduledReportOwner")
  scheduledReportRecipientOf   ScheduledReportRecipient[] @relation("ScheduledReportRecipientUser")
  triggeredScheduledReportRuns ScheduledReportRun[]       @relation("ScheduledReportRunTriggeredBy")
  createdCampaigns             Campaign[]                 @relation("CampaignCreatedBy")
  createdCampaignTemplates     CampaignTemplate[]         @relation("CampaignTemplateCreatedBy")
  ownedAudienceSegments        AudienceSegment[]          @relation("AudienceSegmentOwner")

  // --- Phase 2: Admin / integrations ---
  createdWebhookSubscriptions WebhookSubscription[] @relation("WebhookSubscriptionCreatedBy")

  // --- Enterprise pass: identity ---
  pendingRoleGrants          PendingRoleGrant[]
  requestedPendingRoleGrants PendingRoleGrant[] @relation("PendingRoleGrantRequestedBy")

  @@map("users")
}

model Role {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String             @unique
  description              String?
  isSystemRole             Boolean            @default(false) @map("is_system_role")
  /// Same semantics as ApprovalThresholdRule.requiredApprovals — 1 (the
  /// default) means granting this role is immediate, today's behavior for
  /// every existing role, byte-for-byte unchanged. >1 routes the grant
  /// through a PendingRoleGrant + ApprovalChain instead (see
  /// UsersController.assignRole()), requiring that many distinct approvers
  /// before the UserRole row is actually created. Backfilled to 2 for
  /// ADMIN/COMPLIANCE_OFFICER by this migration; admin-editable afterward.
  requiredApprovalsToGrant Int                @default(1) @map("required_approvals_to_grant")
  permissions              RolePermission[]
  users                    UserRole[]
  pendingGrants            PendingRoleGrant[]
  fieldPermissions         FieldPermission[]
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("roles")
}

enum FieldPermissionVisibility {
  HIDDEN
  READ_ONLY
}

/// Field-Level Security — restricts a single FIELD on a resource (not the
/// whole resource, which `Permission`/`RolePermission`/RLS already gate) for
/// a given role. Opt-in/additive only: a (role, resource, field) pair with
/// no row here is EDITABLE (today's unrestricted behavior, unchanged) — this
/// table only ever narrows access, never widens it. When a caller holds
/// multiple roles, the EFFECTIVE visibility for a field is the MOST
/// permissive value across all their roles (a role with no row contributes
/// EDITABLE) — the same "union of role abilities" principle
/// app_max_scope() already applies for whole-resource scope (see
/// prisma/rls/002_policies.sql), kept consistent here rather than inventing
/// a second, stricter composition rule. `resource`/`fieldName` are plain
/// strings, not FKs — there is no single canonical field catalog in this
/// schema to reference (Prisma model fields, not database rows) — enforced
/// application-side (backend/api/src/common/field-permissions/) against a
/// small fixed allowlist per resource, same "fixed keys, not an open query"
/// convention as SavedView.filters / AutomationRule condition filters.
model FieldPermission {
  id         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId     String                     @map("role_id") @db.Uuid
  role       Role                       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource   String
  fieldName  String                     @map("field_name")
  visibility FieldPermissionVisibility
  createdAt  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([roleId, resource, fieldName])
  @@map("field_permissions")
}

/// The "not yet effective" row an Approval/ApprovalChain points at via
/// entityId for a USER_ROLE_CHANGE — plays the exact same structural role
/// PolicyVersion plays for POLICY_ENDORSEMENT/CANCELLATION approvals (see
/// that model's own doc comment). Deleted once the chain resolves either
/// way: APPROVED creates the real UserRole row first, REJECTED just drops
/// this row — neither outcome leaves it lingering.
model PendingRoleGrant {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId        String   @map("role_id") @db.Uuid
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  requestedById String   @map("requested_by_id") @db.Uuid
  requestedBy   User     @relation("PendingRoleGrantRequestedBy", fields: [requestedById], references: [id])
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("pending_role_grants")
}

/// scope drives the RLS predicate chosen for resources granted by this
/// permission: OWN (ownerId = current user), DEPARTMENT, BRANCH, or ALL.
model Permission {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource String
  action   String
  scope    PermissionScope
  roles    RolePermission[]

  @@unique([resource, action, scope])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model OrgSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedBy   User?    @relation("OrgSettingUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("org_settings")
}

/// Multi-currency support — one row per non-base currency the org quotes
/// business in, storing how many units of the org's base currency (NGN,
/// matching Policy.currency/Opportunity.currency's own default — NGN has
/// no row here, its implicit rate is always 1) one unit of `currencyCode`
/// converts to. Read by dashboards.controller.ts's pipeline/forecast sums
/// to normalize mixed-currency Opportunity.amount values into one
/// comparable total before summing — see toBaseCurrency() there. Admin-
/// managed (see exchange-rates.controller.ts), same RLS-free "config
/// tier" as automation_rules/carriers — reads ungated, writes gated on
/// 'identity' (no dedicated resource, matching field_permissions'
/// reasoning for the same tier).
model ExchangeRate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  currencyCode String   @unique @map("currency_code")
  rateToBase   Decimal  @map("rate_to_base") @db.Decimal(18, 6)
  updatedById  String?  @map("updated_by_id") @db.Uuid
  updatedBy    User?    @relation("ExchangeRateUpdatedBy", fields: [updatedById], references: [id])
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("exchange_rates")
}

model IpWhitelistEntry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cidrRange       String   @map("cidr_range")
  description     String?
