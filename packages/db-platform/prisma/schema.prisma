// TopiaDesk Global Admin — platform control-plane schema.
// Lives in its own Postgres schema ("platform", see PLATFORM_DATABASE_URL/
// PLATFORM_DIRECT_URL), in the SAME database instance as every tenant
// schema (packages/db), but structurally and operationally independent:
// one instance of this schema total, vs. one full tenant-schema instance
// PER customer org. See packages/db-platform/src/client.ts's header
// comment for why this is a separate Prisma project rather than extra
// models bolted onto packages/db.
//
// Row-level-security here is deliberately much simpler than the tenant
// schema's OWN/DEPARTMENT/BRANCH hierarchy (see prisma/rls/002_policies.sql)
// — there is no ownership concept at the platform level, only "is this a
// legitimate platform-admin session (or SYSTEM_JOB)".

// Custom `output` is NOT optional here — packages/db (the tenant schema)
// declares the exact same `@prisma/client`/`prisma` version range with no
// differentiating peer deps, so pnpm's content-addressable store dedupes
// both packages onto ONE shared virtual-store entry, which is also where
// Prisma's DEFAULT (no `output`) generation target lives
// (node_modules/.pnpm/@prisma+client@.../node_modules/.prisma/client).
// Confirmed empirically: generating this schema without `output` silently
// overwrote packages/db's already-generated tenant client in place — every
// tenant-schema type (Account, User, ...) vanished, replaced by this
// schema's types, with no error from either `prisma generate` invocation.
// A package-local, non-hoisted output path sidesteps the shared store
// entirely regardless of how pnpm resolves the dependency graph.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("PLATFORM_DATABASE_URL")
  directUrl = env("PLATFORM_DIRECT_URL")
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  FAILED
  DELETED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ProvisioningStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_TENANT
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// One row per customer organization. `schemaName`/`keycloakRealm` are the
/// two coordinates that locate everything else about this tenant — the
/// actual Postgres schema (packages/db's table set, applied fresh per
/// tenant by the provisioning job) and the Keycloak realm its users
/// authenticate against. Neither is derived at read time; both are decided
/// once at creation (from `slug`) and stored, so renaming a tenant's
/// display `name` later never risks touching live infrastructure.
model Tenant {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  slug                String       @unique
  schemaName          String       @unique @map("schema_name")
  keycloakRealm       String       @unique @map("keycloak_realm")
  /// DNS-safe subdomain label (`slug` with `_` -> `-`), reachable at
  /// `<subdomain>.<root domain>`. Nullable: legacy/irregular rows (e.g. a
  /// tenant whose keycloakRealm doesn't follow the tenant_<slug>
  /// convention) simply have no working tenant-subdomain and fall back to
  /// the default app.<root domain> entry point — no backfill required.
  subdomain           String?      @unique
  /// MinIO object key for this tenant's uploaded login-page logo — same
  /// storage-key-on-the-row pattern as User.avatarStorageKey
  /// (packages/db/prisma/schema.prisma), just scoped to the platform's
  /// Tenant instead. Null means "no custom logo" — the Keycloak login
  /// theme (infra/keycloak/themes/topiadesk/login/template.ftl) falls back
  /// to the baked-in TopiaDesk mark via an <img onerror> handler, since the
  /// login page itself has no session yet and can't know in advance
  /// whether a given realm has a logo to show.
  logoStorageKey      String?      @map("logo_storage_key")
  status              TenantStatus @default(PROVISIONING)
  primaryContactEmail String       @map("primary_contact_email")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription       Subscription?
  provisioningEvents TenantProvisioningEvent[]
  supportTickets     SupportTicket[]

  @@map("tenants")
}

/// Deliberately thin — no pricing/billing fields (Phase 1 is internal
/// tracking only, see the plan's scoping decision). `seatLimit` is what
/// Phase 3's seat-enforcement would check against a tenant's active user
/// count; unused for now beyond display.
model Plan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  seatLimit   Int      @map("seat_limit")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("plans")
}

/// One-to-one with Tenant, not embedded directly on it — keeps the
/// "which plan, what billing period" concern separable from tenant
/// identity/provisioning state, and leaves room for a real subscription
/// history (plan changes over time) without widening Tenant itself later.
model Subscription {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String             @unique @map("tenant_id") @db.Uuid
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId           String             @map("plan_id") @db.Uuid
  plan             Plan               @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime?          @map("current_period_end") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("subscriptions")
}

/// Global Admin's OWN operator accounts (TopiaDesk company staff) —
/// completely separate from any tenant's `users` table, authenticated
/// against the "topiadesk-platform" Keycloak realm, never a tenant realm.
enum PlatformAdminRole {
  SUPPORT
  SUPER_ADMIN
}

model PlatformAdminUser {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keycloakSubjectId String            @unique @map("keycloak_subject_id")
  email             String            @unique
  fullName          String            @map("full_name")
  status            String            @default("ACTIVE")
  /// App-layer privilege tier, checked by PlatformRoleGuard — deliberately
  /// DB-only, not a Keycloak realm role (KeycloakAdminService has no role/
  /// group-assignment methods at all; same "RBAC lives in Postgres, never
  /// realm_access.roles" principle infra/keycloak/README.md documents for
  /// the tenant realm applies here too). Default SUPPORT governs admins
  /// created from here on — every row that existed before this field was
  /// added was promoted to SUPER_ADMIN by this migration's own data-fix
  /// (see prisma/migrations/20260809040000_add_platform_admin_role), not
  /// by this default, since nobody's access should silently shrink for
  /// having existed first.
  role              PlatformAdminRole @default(SUPPORT)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignedTickets SupportTicket[]
  ticketComments  SupportTicketComment[]
  auditLogEntries PlatformAuditLog[]

  @@map("platform_admin_users")
}

/// Append-only progress/audit trail for one tenant's provisioning run
/// (create schema -> migrate -> RLS -> baseline seed -> Keycloak realm ->
/// first admin user -> active), so the Global Admin UI can show real
/// progress/failure detail instead of a single opaque spinner. See
/// backend/worker/src/jobs/platform/provision-tenant.job.ts.
model TenantProvisioningEvent {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String                 @map("tenant_id") @db.Uuid
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  step       String
  status     ProvisioningStepStatus
  detail     String?
  occurredAt DateTime               @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([tenantId, occurredAt])
  @@map("tenant_provisioning_events")
}

/// A tenant admin's support request to TopiaDesk itself — distinct from
/// the tenant schema's own `cases` table (that's for the tenant's OWN
/// customers, see packages/db/prisma/schema.prisma's Case model). Written
/// by backend/worker's create-support-ticket job (not directly from the
/// tenant-authenticated request that creates it) — see this session's
/// plan for why tenant-context requests reaching into this schema go
/// through SYSTEM_JOB_CONTEXT rather than the tenant user's own RlsContext.
/// `raisedByEmail`/`raisedByName` are captured at creation time rather than
/// a foreign key — there's no cross-schema FK to a tenant's own `users`
/// table to point at.
model SupportTicket {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject        String
  description    String
  status         SupportTicketStatus    @default(OPEN)
  priority       SupportTicketPriority  @default(MEDIUM)
  raisedByEmail  String                 @map("raised_by_email")
  raisedByName   String                 @map("raised_by_name")
  assignedToId   String?                @map("assigned_to_id") @db.Uuid
  assignedTo     PlatformAdminUser?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt     DateTime?              @map("resolved_at") @db.Timestamptz(6)
  closedAt       DateTime?              @map("closed_at") @db.Timestamptz(6)

  comments SupportTicketComment[]

  @@index([tenantId])
  @@index([status])
  @@map("support_tickets")
}

/// `authorPlatformAdminId` null = a tenant-side reply (there's no
/// cross-schema FK to point at instead, same reasoning as SupportTicket's
/// raisedByEmail/raisedByName — authorName/authorEmail are captured at
/// write time for that case).
model SupportTicketComment {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId              String             @map("ticket_id") @db.Uuid
  ticket                SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorPlatformAdminId String?            @map("author_platform_admin_id") @db.Uuid
  authorPlatformAdmin   PlatformAdminUser? @relation(fields: [authorPlatformAdminId], references: [id], onDelete: SetNull)
  authorName            String             @map("author_name")
  authorEmail           String             @map("author_email")
  body                  String
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ticketId])
  @@map("support_ticket_comments")
}

/// Every mutating /platform/* action, for accountability — deliberately
/// NOT hash-chained like the tenant schema's own `audit_log` (see
/// packages/db/prisma/triggers/002_audit_chain_triggers.sql): this schema
/// has no trigger infrastructure at all (confirmed absent when this
/// session surveyed it), and platform-admin action volume is low enough
/// that a plain append-only table is the right amount of ceremony for
/// this pass. `actorPlatformAdminId` is nullable for SYSTEM_JOB-originated
/// rows (there are none yet, but the shape matches every other nullable
/// actor FK in this schema for the same reason).
model PlatformAuditLog {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorPlatformAdminId  String?            @map("actor_platform_admin_id") @db.Uuid
  actorPlatformAdmin    PlatformAdminUser? @relation(fields: [actorPlatformAdminId], references: [id], onDelete: SetNull)
  action                String
  entityType            String             @map("entity_type")
  entityId              String             @map("entity_id")
  detail                Json?
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("platform_audit_log")
}

enum PlatformNotificationType {
  TENANT_PROVISIONED
  TENANT_PROVISIONING_FAILED
  TENANT_SUSPENDED
  TENANT_REACTIVATED
  SUPPORT_TICKET_CREATED
}

/// Broadcast to every platform admin, with a SHARED read state — any admin
/// marking a row read marks it read for everyone, not per-recipient like
/// the tenant schema's own `Notification` model
/// (packages/db/prisma/schema.prisma). Deliberate simplification for team
/// scale (a handful of platform admins today); a per-recipient/per-read
/// design is the natural next step if that stops being true. No FK on
/// entityType/entityId (display-only feed, same "no cross-schema FK"
/// reasoning as SupportTicketComment's actor field below) — a stale
/// entityId (e.g. a deleted tenant) can silently dangle, which is
/// acceptable since nothing consults this table for referential logic.
model PlatformNotification {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type       PlatformNotificationType
  title      String
  body       String?
  entityType String?                  @map("entity_type")
  entityId   String?                  @map("entity_id")
  readAt     DateTime?                @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("platform_notifications")
}
