# =============================================================================
# TopiaDesk CRM — environment configuration template.
# Copy to .env and fill in real values. NEVER commit .env.
# In production, prefer Docker secrets / SOPS-encrypted files over plain .env —
# see docs/runbook.md "Secrets management".
#
# IMPORTANT if you're scripting secret generation (e.g. replacing every
# change_me_* placeholder with a random value via a naive find/replace):
# POSTGRES_MIGRATOR_PASSWORD/POSTGRES_RUNTIME_PASSWORD/REDIS_PASSWORD each
# appear a SECOND time, embedded inside DATABASE_URL/DIRECT_URL/REDIS_URL
# below. A regex that independently randomizes every change_me_* occurrence
# will give the embedded copy a DIFFERENT value than the standalone one —
# same secret, two different values — which fails authentication in a way
# that's genuinely confusing to debug (Postgres/Redis report a real
# password mismatch, not a config error). Generate the standalone values
# first, then substitute those exact values into the three *_URL lines —
# don't randomize the *_URL lines independently. Caught during Phase 0
# local verification; this is exactly the mistake that happened.
# =============================================================================

# --- General ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
APP_BASE_DOMAIN=topiadesk.localhost
APP_URL=https://app.topiadesk.localhost
API_URL=https://api.topiadesk.localhost
# Same API, reached by service name on the Docker network instead of
# through Traefik — *.topiadesk.localhost is a host-machine (or browser)
# DNS entry, not something Docker's embedded DNS resolves, so anything
# calling the API from INSIDE another container (e.g. apps/web's Next.js
# server doing SSR data fetching) must use this instead of API_URL.
API_INTERNAL_URL=http://api:4000
WEB_PORT=3000
API_PORT=4000
WORKER_METRICS_PORT=9100
# Global Admin — a separate app/subdomain from APP_URL/WEB_PORT above, see
# frontend/global-admin.
GLOBAL_ADMIN_URL=https://platform.topiadesk.localhost
GLOBAL_ADMIN_PORT=3010

# --- Postgres ----------------------------------------------------------------
# app_migrator: owns schema, runs migrations. app_runtime: DML only, no BYPASSRLS,
# used by api/worker at runtime — this split is what makes RLS actually enforced.
POSTGRES_DB=topiadesk
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_postgres_superuser
POSTGRES_MIGRATOR_USER=app_migrator
POSTGRES_MIGRATOR_PASSWORD=change_me_migrator
POSTGRES_RUNTIME_USER=app_runtime
POSTGRES_RUNTIME_PASSWORD=change_me_runtime
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- PgBouncer (transaction pooling in front of Postgres) -------------------
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=25

# Pooled URL (used by api/worker at runtime, via PgBouncer, ?pgbouncer=true is
# required so Prisma disables prepared-statement caching that breaks under
# transaction-mode pooling). Direct URL bypasses PgBouncer for Prisma Migrate
# and anything needing session-level features (advisory locks).
DATABASE_URL=postgresql://app_runtime:change_me_runtime@pgbouncer:6432/topiadesk?pgbouncer=true&schema=public
DIRECT_URL=postgresql://app_migrator:change_me_migrator@postgres:5432/topiadesk?schema=public

# Global Admin's own control-plane schema ("platform") — same database
# instance, same roles, different schema. See packages/db-platform.
PLATFORM_DATABASE_URL=postgresql://app_runtime:change_me_runtime@pgbouncer:6432/topiadesk?pgbouncer=true&schema=platform
PLATFORM_DIRECT_URL=postgresql://app_migrator:change_me_migrator@postgres:5432/topiadesk?schema=platform

# --- Redis --------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis
REDIS_URL=redis://:change_me_redis@redis:6379

# --- MinIO (S3-compatible object storage) ------------------------------------
MINIO_ROOT_USER=topiadesk_minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_root_min_8_chars
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_DOCUMENTS_BUCKET=topiadesk-documents
MINIO_AUDIT_WORM_BUCKET=topiadesk-audit-worm
MINIO_BACKUPS_BUCKET=topiadesk-backups
# Scoped application credentials (created by minio-init, not the root user)
MINIO_APP_ACCESS_KEY=change_me_app_access_key
MINIO_APP_SECRET_KEY=change_me_app_secret_key

# --- Keycloak (identity provider) --------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin
KEYCLOAK_HOSTNAME=auth.topiadesk.localhost
KEYCLOAK_URL=https://auth.topiadesk.localhost
KEYCLOAK_REALM=topiadesk
KEYCLOAK_CLIENT_ID_API=topiadesk-api
KEYCLOAK_CLIENT_SECRET_API=change_me_api_client_secret
KEYCLOAK_CLIENT_ID_WEB=topiadesk-web
KEYCLOAK_ISSUER_URL=https://auth.topiadesk.localhost/realms/topiadesk
KEYCLOAK_JWKS_URI=https://auth.topiadesk.localhost/realms/topiadesk/protocol/openid-connect/certs
# Docker Compose only: *.topiadesk.localhost resolves via host-machine/browser
# DNS (or Chromium's built-in .localhost handling), never Docker's embedded
# DNS — so api/web's server-side calls to Keycloak (JWKS fetch, OIDC
# discovery, token exchange) must reach it by service name instead. Leave
# unset for a real deployment where public DNS resolves everywhere; api/web
# then talk to KEYCLOAK_ISSUER_URL's host directly.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
# DB used by Keycloak itself (separate logical DB on the same Postgres instance)
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change_me_keycloak_db
# Shared secret for the identity module's Keycloak user-sync webhook receiver
# (POST /identity/webhooks/keycloak — see backend/api/src/modules/identity/
# keycloak-webhook.controller.ts). Not yet wired into packages/config's
# zod-validated Env or into a live Keycloak event-listener subscription —
# both are explicitly left to a follow-up integration pass. Read directly
# via process.env in keycloak-webhook.guard.ts until then.
KEYCLOAK_WEBHOOK_SECRET=change_me_keycloak_webhook_secret

# --- Global Admin's own realm (infra/keycloak/platform-realm-export.json) ---
# Completely separate from the topiadesk (tenant) realm above — TopiaDesk's
# own staff, never a customer org's users. Same *.localhost DNS caveat as
# KEYCLOAK_INTERNAL_URL above applies to the JWKS URI.
KEYCLOAK_PLATFORM_REALM=topiadesk-platform
KEYCLOAK_PLATFORM_CLIENT_ID=topiadesk-global-admin
KEYCLOAK_PLATFORM_ISSUER_URL=https://auth.topiadesk.localhost/realms/topiadesk-platform
KEYCLOAK_PLATFORM_JWKS_URI=https://auth.topiadesk.localhost/realms/topiadesk-platform/protocol/openid-connect/certs

# --- "Sign in with Microsoft" (Keycloak identity broker) ---------------------
# Registered in infra/keycloak/realm-export.json as a DISABLED identity
# provider (alias "microsoft") — safe to leave unset, nothing changes until
# someone enables it in the Keycloak Admin Console. To turn it on: create an
# Azure AD (Entra ID) App Registration (Azure Portal -> Entra ID -> App
# registrations -> New registration), add a Web platform redirect URI of
# https://auth.topiadesk.localhost/realms/topiadesk/broker/microsoft/endpoint,
# create a client secret under Certificates & secrets, then fill these three
# in and flip the provider to Enabled under Identity Providers -> microsoft in
# the Keycloak Admin Console (a realm-export.json change alone only applies
# on a fresh realm import, not to an already-running realm).
MICROSOFT_IDP_TENANT_ID=change_me_or_common_for_multi_tenant
MICROSOFT_IDP_CLIENT_ID=change_me_azure_app_client_id
MICROSOFT_IDP_CLIENT_SECRET=change_me_azure_app_client_secret

# Shared secret for the campaign-management module's provider-callback
# webhooks (POST campaigns/webhooks/email|sms|whatsapp/events — see
# backend/api/src/modules/campaigns/campaign-webhook.guard.ts). Same pattern
# as KEYCLOAK_WEBHOOK_SECRET above; wired into packages/config's
# zod-validated Env.
CAMPAIGN_WEBHOOK_SECRET=change_me_campaign_webhook_secret
OMNICHANNEL_WEBHOOK_SECRET=change_me_omnichannel_webhook_secret

# --- Web session/cookies -----------------------------------------------------
# frontend/web keeps only an opaque session ID in the `td_session` cookie and
# stores the real Keycloak tokens server-side in Redis (REDIS_URL above, the
# same instance api/worker use, under a `websession:` key prefix). Three full
# JWTs exceed the ~4096-byte per-cookie limit browsers enforce, which
# silently breaks login in a real browser — hence the server-side store.
WEB_SESSION_SECRET=change_me_generate_32_byte_random_hex
WEB_COOKIE_DOMAIN=.topiadesk.localhost
# frontend/global-admin's own session-encryption secret — deliberately
# separate from WEB_SESSION_SECRET (a leak of one must never forge the
# other's cookies). Same `gadmin_session` + Redis-backed store shape.
GLOBAL_ADMIN_SESSION_SECRET=change_me_generate_32_byte_random_hex

# --- AI Gateway (Anthropic / Claude API) -------------------------------------
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
AI_GATEWAY_MODEL=claude-sonnet-5
AI_ORG_MONTHLY_SPEND_CAP_USD=500
AI_PER_USER_DAILY_REQUEST_CAP=100
# Anthropic has no embeddings API — Voyage AI (https://voyageai.com) is
# Anthropic's recommended embeddings partner, used for /ai/index and
# /ai/search. Optional — semantic search fails gracefully (503) if unset,
# same as ANTHROPIC_API_KEY. Spend is metered into the SAME
# AI_ORG_MONTHLY_SPEND_CAP_USD pool above, not a separate cap.
VOYAGE_API_KEY=pa-REPLACE_ME

# --- Mail (dev: MailDev capture; prod: point at real SMTP/SES) --------------
SMTP_HOST=maildev
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="TopiaDesk CRM <no-reply@topiadesk.localhost>"
MAILDEV_WEB_PORT=1080
MAILDEV_SMTP_PORT=1025

# --- Observability -------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin
PROMETHEUS_RETENTION=30d
LOKI_RETENTION_HOURS=720

# --- Backup / DR ---------------------------------------------------------------
BACKUP_CRON_SCHEDULE="0 */6 * * *"
BACKUP_RETENTION_DAYS=30
WAL_ARCHIVE_TIMEOUT_SECONDS=300

# --- Traefik / TLS ---------------------------------------------------------------
TRAEFIK_ACME_EMAIL=geremoses1@gmail.com
TRAEFIK_DASHBOARD_ENABLED=false

# --- Security ------------------------------------------------------------------
IP_WHITELIST_ENFORCED=false
MFA_REQUIRED_FOR_ROLES=ADMIN,COMPLIANCE
# Keycloak Admin REST API service-account client (realm-management:manage-
# users role) — used only for forced-logout/session-list
# (backend/api/src/modules/identity/keycloak-admin.service.ts). Deliberately
# separate from KEYCLOAK_CLIENT_ID_API/KEYCLOAK_CLIENT_SECRET_API, which only
# ever verifies JWTs and never calls back into Keycloak. Optional/lazy, same
# reasoning as ANTHROPIC_API_KEY.
KEYCLOAK_ADMIN_CLIENT_ID=topiadesk-api-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change_me_keycloak_admin_client_secret
# AES-256-GCM key (32 random bytes, hex-encoded — `openssl rand -hex 32`) for
# app-layer encryption of IntegrationOAuthCredential's stored access/refresh
# tokens. Required — see packages/config/src/env.ts's comment on why this one
# isn't optional the way the AI keys above are.
INTEGRATION_TOKEN_ENCRYPTION_KEY=change_me_generate_32_byte_random_hex
